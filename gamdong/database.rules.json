{
  "rules": {
    ".read": true,
    ".write": "auth != null && auth.token.email === 'idealjade7@gmail.com' && auth.token.email_verified === true",

    "votes": {
      "$cid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('state/phase').val() === 'open' && root.child('state/currentId').val() === $cid",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "presence": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber()"
      }
    }
  }
}
